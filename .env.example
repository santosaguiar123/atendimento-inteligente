# Copie este arquivo para .env e ajuste os valores conforme necessário.
# NUNCA versione o arquivo .env real (ele já está no .gitignore).

# --- Banco de dados (PostgreSQL) ---
POSTGRES_DB=atendimento
POSTGRES_USER=atendimento
POSTGRES_PASSWORD=troque-esta-senha
# POSTGRES_HOST e POSTGRES_PORT: usados pelo Django. Ao rodar via Docker Compose,
# o backend sobrescreve POSTGRES_HOST=db automaticamente (ver docker-compose.yml).
# Ao rodar o backend fora do Docker (localmente), use POSTGRES_HOST=localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-gerada-aleatoriamente
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- IA ---
# Único valor suportado no MVP: "stub" (ver backend/ai/services.py).
AI_PROVIDER=stub
# Quando um provider real for adicionado (Fase 7 do roadmap), a respectiva chave
# de API deve ser lida de uma variável de ambiente aqui, nunca hardcoded no código.
# AI_PROVIDER_API_KEY=

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api
