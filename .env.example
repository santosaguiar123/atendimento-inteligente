# Copie este arquivo para .env e ajuste os valores conforme necessário.
# NUNCA versione o arquivo .env real (ele já está no .gitignore).

# --- Banco de dados (PostgreSQL) ---
POSTGRES_DB=atendimento
POSTGRES_USER=atendimento
POSTGRES_PASSWORD=<configure-a-senha-localmente>
# POSTGRES_HOST e POSTGRES_PORT: usados pelo Django. Ao rodar via Docker Compose,
# o backend sobrescreve POSTGRES_HOST=db automaticamente (ver docker-compose.yml).
# Ao rodar o backend fora do Docker (localmente), use POSTGRES_HOST=localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=<configure-a-chave-localmente>
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- IA ---
# Use "stub" para resposta simulada sem chave ou "openrouter" para respostas reais.
AI_PROVIDER=stub
# Chave da conta: https://openrouter.ai/settings/keys; usada apenas no backend.
OPENROUTER_API_KEY=
# Esta configuração aceita somente o roteador gratuito ou modelos com sufixo :free.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MAX_TOKENS=350
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_SITE_URL=http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api

# --- Producao (docker-compose.prod.yml) ---
# Copie para .env.production (ignorado pelo Git). Configure voce mesmo os
# valores reais de DJANGO_SECRET_KEY e POSTGRES_PASSWORD.
# Em volume existente, alterar POSTGRES_PASSWORD nao troca a senha do banco.
# Nao use placeholders em producao. Defina DJANGO_DEBUG=False e
# DJANGO_ALLOWED_HOSTS com dominios reais, sem esquema/porta e sem '*'.
# O Compose de producao forca DEBUG=False e builda VITE_API_URL=/api.
# CORS nao e necessario: frontend e API usam a mesma origem.
# Descomente e substitua somente se precisar mudar os padroes:
# PROD_HTTP_PORT=<porta-http-local; padrao 8080>
# PROD_BIND_ADDRESS=<interface-de-escuta; padrao 127.0.0.1>
# GUNICORN_WORKERS=<numero-de-processos; padrao 2>
# GUNICORN_TIMEOUT=<timeout-em-segundos; padrao 120>
# OPENROUTER_SITE_URL=<url-publica-do-site>
# Para respostas reais: AI_PROVIDER=openrouter e OPENROUTER_API_KEY preenchida.
# Preencher apenas a chave mantendo stub nao ativa o OpenRouter.
# Consulte PRODUCTION.md para migrations, volumes e comandos de inicializacao.
