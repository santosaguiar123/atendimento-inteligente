# URL base da API do backend. Em desenvolvimento com Docker Compose, o frontend
# roda no navegador do host, então usa localhost (não o nome do serviço "backend").
VITE_API_URL=http://localhost:8000/api

# No Dockerfile.prod, a URL e fixada em /api durante o build.
# Nunca coloque chaves privadas em variaveis VITE_*.
